generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  ADMIN
  AMBASSADOR
  PARTICIPANT
}

enum HackathonStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  LIVE
  EVALUATION
  COMPLETED
}

enum CreditTransactionType {
  INCREASE
  DECREASE
  CORRECTION
  BONUS_APPROVED
  REMOVAL
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  DISQUALIFIED
}

enum RegistrationStatus {
  REGISTERED
  ATTENDED
  MISSED
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  LATE
  EVALUATED
}

enum TeamStatus {
  FORMING
  LOCKED
  DISQUALIFIED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum CertificateType {
  PARTICIPATION
  WINNER_FIRST
  WINNER_SECOND
  WINNER_THIRD
  TOP_TEN
}

enum NotificationType {
  INFO
  ALERT
  SUCCESS
  WARNING
}

// ==========================================
// USER MANAGEMENT
// ==========================================

model User {
  id                  String    @id @default(uuid())
  name                String
  email               String    @unique
  password            String
  role                Role
  avatar              String?
  phone               String?
  department          String    @default("IT")
  year                Int?
  registerNumber      String?   @unique
  status              String    @default("ACTIVE")
  forcePasswordChange Boolean   @default(true)
  emailVerified       Boolean   @default(false)
  canDeductCredits    Boolean   @default(false)
  lastLogin           DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft Delete

  // Relations
  studentProfile    Student?
  adminProfile      Admin?
  ambassadorProfile Ambassador?

  activityLogs                ActivityLog[]
  auditLogs                   AuditLog[]
  notifications               Notification[]
  loginLogs                   LoginLog[]
  attendanceRecords           AttendanceRecord[]  @relation("UserAttendance")
  markedAttendance            AttendanceRecord[]  @relation("MarkedAttendance")
  performedCreditTransactions CreditTransaction[] @relation("PerformedCredits")
}

model Student {
  studentId           String @id @default(uuid())
  userId              String @unique
  batch               String
  section             String
  semester            Int
  currentCredits      Int    @default(0)
  lifetimeCredits     Int    @default(0)
  currentStreak       Int    @default(0)
  bestStreak          Int    @default(0)
  totalParticipations Int    @default(0)
  totalWins           Int    @default(0)

  github    String?
  linkedin  String?
  portfolio String?
  bio       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  registrations      Registration[]
  teamMembers        TeamMember[]
  certificates       Certificate[]
  creditTransactions CreditTransaction[]
  studentBadges      StudentBadge[]
}

model Ambassador {
  ambassadorId    String   @id @default(uuid())
  userId          String   @unique
  assignedYear    Int
  assignedSection String
  permissions     String[] // JSON or array of permission strings

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Admin {
  adminId     String @id @default(uuid())
  userId      String @unique
  designation String
  department  String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// CORE HACKATHON
// ==========================================

model Semester {
  id        String   @id @default(uuid())
  name      String // e.g., "Even 2026"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)

  hackathons Hackathon[]
}

model Hackathon {
  id                 String          @id @default(uuid())
  title              String
  description        String
  theme              String
  banner             String?
  poster             String?
  venue              String
  registrationOpen   DateTime
  registrationClose  DateTime
  problemReleaseTime DateTime
  submissionDeadline DateTime
  status             HackathonStatus @default(DRAFT)

  semesterId String
  semester   Semester @relation(fields: [semesterId], references: [id])
  createdBy  String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  registrations      Registration[]
  teams              Team[]
  certificates       Certificate[]
  creditTransactions CreditTransaction[]
  AttendanceRecord   AttendanceRecord[]
}

// ==========================================
// PARTICIPATION
// ==========================================

model Registration {
  id               String             @id @default(uuid())
  hackathonId      String
  studentId        String
  teamId           String?
  registeredAt     DateTime           @default(now())
  attendanceStatus RegistrationStatus @default(REGISTERED)
  submissionStatus SubmissionStatus   @default(PENDING)

  hackathon Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [studentId], references: [studentId], onDelete: Cascade)
  team      Team?     @relation(fields: [teamId], references: [id])

  @@unique([hackathonId, studentId])
}

model Team {
  id          String     @id @default(uuid())
  teamName    String
  captainId   String
  hackathonId String
  status      TeamStatus @default(FORMING)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  hackathon     Hackathon      @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  members       TeamMember[]
  registrations Registration[]
  submissions   Submission[]
}

model TeamMember {
  teamId       String
  studentId    String
  inviteStatus InviteStatus @default(PENDING)
  joinedAt     DateTime     @default(now())

  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [studentId], onDelete: Cascade)

  @@id([teamId, studentId])
}

// ==========================================
// SUBMISSIONS & EVALUATION
// ==========================================

model Submission {
  id             String   @id @default(uuid())
  teamId         String
  githubLink     String
  pptFile        String?
  zipFile        String?
  documentation  String?
  demoVideo      String?
  submittedAt    DateTime @default(now())
  lateSubmission Boolean  @default(false)

  team             Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  evaluationScores EvaluationScore[]
}

model EvaluationScore {
  id           String @id @default(uuid())
  submissionId String
  judgeName    String

  innovation   Int
  technical    Int
  ui           Int
  presentation Int
  impact       Int
  remarks      String?

  totalScore Int
  rank       Int?

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

// ==========================================
// REWARDS & LEADERBOARD
// ==========================================

model Certificate {
  certificateId     String          @id @default(uuid())
  studentId         String
  hackathonId       String
  type              CertificateType
  issueDate         DateTime        @default(now())
  qrCode            String?
  verificationToken String          @unique

  student   Student   @relation(fields: [studentId], references: [studentId], onDelete: Cascade)
  hackathon Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
}

model CreditTransaction {
  id            String                @id @default(uuid())
  studentId     String
  hackathonId   String?
  reason        String // E.g., "Participation", "Winner"
  points        Int
  type          CreditTransactionType @default(INCREASE)
  performedById String?
  createdAt     DateTime              @default(now())

  student     Student    @relation(fields: [studentId], references: [studentId], onDelete: Cascade)
  hackathon   Hackathon? @relation(fields: [hackathonId], references: [id])
  performedBy User?      @relation("PerformedCredits", fields: [performedById], references: [id])
}

// Leaderboard has been removed as it is a derived value.

model Badge {
  id          String  @id @default(uuid())
  name        String
  description String
  imageUrl    String?

  students StudentBadge[]
}

model StudentBadge {
  studentId String
  badgeId   String
  awardedAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [studentId], onDelete: Cascade)
  badge   Badge   @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([studentId, badgeId])
}

// ==========================================
// SYSTEM & LOGGING
// ==========================================

model LoginLog {
  id           String   @id @default(uuid())
  userId       String
  loginAt      DateTime @default(now())
  ipAddress    String?
  browser      String?
  os           String?
  location     String?
  isSuspicious Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AttendanceRecord {
  id          String           @id @default(uuid())
  userId      String
  hackathonId String
  status      AttendanceStatus
  markedById  String
  createdAt   DateTime         @default(now())

  user      User      @relation("UserAttendance", fields: [userId], references: [id], onDelete: Cascade)
  hackathon Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  markedBy  User      @relation("MarkedAttendance", fields: [markedById], references: [id])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  details   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String
  action        String // E.g., Delete, Edit, Create, Approve
  entity        String // E.g., "Hackathon", "Settings"
  target        String? // ID or name of the target entity
  previousValue String? // JSON string
  newValue      String? // JSON string
  details       String?
  browser       String?
  ipAddress     String?
  reason        String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Settings {
  id    String @id @default(uuid())
  key   String @unique
  value String // JSON string
}

model Gallery {
  id          String   @id @default(uuid())
  hackathonId String?
  imageUrl    String
  caption     String?
  uploadedBy  String
  uploadedAt  DateTime @default(now())
}
