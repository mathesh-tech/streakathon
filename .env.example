# PostgreSQL Database Connection String
# Get this from Neon, Supabase, Railway, etc.
# Note: If you use a connection pooler, add DIRECT_URL to your schema.prisma
DATABASE_URL="postgresql://user:password@host:5432/database"

# NextAuth Configuration
# Generate a secret using: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-nextauth-string"
AUTH_SECRET="your-super-secret-nextauth-string"
NEXTAUTH_URL="http://localhost:3000"

# General Application URL
APP_URL="http://localhost:3000"

# Email Configuration (Resend or other provider)
# Get this from https://resend.com
EMAIL_PROVIDER="resend"
EMAIL_API_KEY="re_..."
RESEND_API_KEY="re_..."

# File Storage Configuration (AWS S3, Supabase Storage, Vercel Blob, etc.)
UPLOAD_PROVIDER="vercel_blob"
UPLOAD_TOKEN="your_upload_token"
STORAGE_BUCKET="your_bucket_name"

# Environment & Logging
NODE_ENV="development" # Set to 'production' on deployment
LOG_LEVEL="info"

# Cron Jobs (Optional, for Vercel Cron)
CRON_SECRET="your-cron-secret-key"
